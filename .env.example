# Larp Launcher — Variáveis de Ambiente (em RUNTIME, lidas pelo app)
#
# Estas ENVs são configuradas DENTRO DO APP em Ajustes → Servidor/Discord/Voz.
# Não precisam ser definidas em build time. O app lê de:
#   1. filesDir/larp-env.json  (salvo quando você mexe em Ajustes)
#   2. assets/larp-env.json    (defaults que vêm no APK)
#
# Para gerar um APK com defaults diferentes, edite:
#   app/src/main/assets/larp-env.json
#
# Apenas uma ENV é de build (não-runtime):
#   larpFridaVersion=17.2.1   (em gradle.properties — versão do Frida gadget a baixar)

# === Defaults embutidos no app (assets/larp-env.json) ===
apiUrl=https://larp-api.workers.dev
wsUrl=wss://larp-api.workers.dev
discordClientId=
discordRedirectUri=com.larp.launcher://oauth
discordScope=identify email guilds
webrtcIceServers=stun:stun.larp.workers.dev:3478
turnUrl=
turnUser=
turnCredential=
gamePackage=com.innersloth.spacemafia
fridaGadgetBundled=true
sentryDsn=
fcmSenderId=
