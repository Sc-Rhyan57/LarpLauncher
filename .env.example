# Discord OAuth (crie em https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=com.larp.launcher://oauth
DISCORD_SCOPE=identify email guilds

# Backend Cloudflare (substitua pelo URL do seu Worker)
LARP_API_URL=https://larp-api.workers.dev

# Cloudflare Calls (WebRTC)
LARP_TURN_URL=turn:turn.larp.workers.dev:3478
LARP_TURN_USERNAME=
LARP_TURN_CREDENTIAL=

# Push de notificações (opcional)
LARP_FCM_SENDER_ID=

# Sentry / Telemetria (opcional)
LARP_SENTRY_DSN=
