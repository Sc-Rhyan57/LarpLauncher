<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Larp.Launcher" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/larp_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Larp.Launcher.Splash" parent="Theme.Larp.Launcher">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/larp_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@mipmap/ic_launcher</item>
    </style>
</resources>
